{
  "name": "BUTingMobile",
  "version": "1.2.3-alpha",
  "private": true,
  "scripts": {
    "android": "node scripts/run-android.cjs",
    "android:avd": "node scripts/run-android.cjs -- --avd",
    "ios": "react-native run-ios",
    "logs:android": "react-native log-android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "react-native start",
    "start:lan": "node scripts/start-lan.cjs",
    "connect:android": "node scripts/connect-android.cjs",
    "start:tunnel": "node scripts/start-tunnel.cjs",
    "ngrok:auth": "node scripts/ngrok-auth.cjs",
    "kakao:sync": "node scripts/sync-kakao-map-key.cjs",
    "map:sync": "node scripts/optimize-busan-map-svg.cjs && node scripts/extract-busan-map-paths.cjs",
    "api:sync": "node scripts/sync-api-config.cjs",
    "chat:test": "node scripts/test-zone-chat.cjs",
    "chat:test:pagination": "node scripts/test-zone-chat-pagination.cjs",
    "zone-boundaries:sync": "node scripts/build-busan-district-boundaries.cjs",
    "oauth:sync": "node scripts/sync-oauth-config.cjs",
    "hooks:install": "node scripts/install-git-hooks.cjs",
    "fonts:sync": "node scripts/sync-pretendard-fonts.cjs",
    "postinstall": "node scripts/sync-kakao-map-key.cjs && node scripts/sync-api-config.cjs && node scripts/sync-oauth-config.cjs && node scripts/sync-pretendard-fonts.cjs && patch-package && node scripts/pin-metro-image-size.cjs && node scripts/install-git-hooks.cjs",
    "test": "jest",
    "e2e": "node scripts/run-e2e.cjs test --exclude-tags shared .maestro/flows/setup .maestro/flows/main",
    "e2e:smoke": "node scripts/run-e2e.cjs test --include-tags smoke --exclude-tags shared .maestro/flows/setup .maestro/flows/main",
    "icons:generate": "node scripts/generate-app-icons.cjs"
  },
